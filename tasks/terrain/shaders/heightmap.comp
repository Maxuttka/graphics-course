#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, r32f) uniform writeonly image2D heightMap;

layout(push_constant) uniform Params
{
  float frequency;
  float lacunarity;
  float gain;
  float amplitude;
  float radius;
  float falloff;
  float seaLevel;
  int seed;
  int octaves;
} params;

float hash(vec2 point)
{
  point = fract(point * vec2(123.34, 456.21));
  point += dot(point, point + 45.32 + float(params.seed));
  return fract(point.x * point.y);
}

float noise2d(vec2 point)
{
  vec2 cell = floor(point);
  vec2 local = fract(point);
  vec2 blend = local * local * (3.0 - 2.0 * local);
  float a = hash(cell);
  float b = hash(cell + vec2(1.0, 0.0));
  float c = hash(cell + vec2(0.0, 1.0));
  float d = hash(cell + vec2(1.0, 1.0));
  return mix(mix(a, b, blend.x), mix(c, d, blend.x), blend.y);
}

float fbm(vec2 point)
{
  float value = 0.0;
  float weight = 1.0;
  float weightSum = 0.0;
  float frequency = params.frequency;

  for (int octave = 0; octave < 10; ++octave)
  {
    if (octave >= params.octaves)
      break;

    value += noise2d(point * frequency) * weight;
    weightSum += weight;
    frequency *= params.lacunarity;
    weight *= params.gain;
  }

  return value / weightSum;
}

void main()
{
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(heightMap);
  if (pixel.x >= size.x || pixel.y >= size.y)
    return;

  vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
  vec2 point = uv * 2.0 - 1.0;
  float radial = smoothstep(params.radius, params.radius + params.falloff, length(point));
  float value = fbm(point) * params.amplitude - radial;
  float height = clamp((value - params.seaLevel) / max(1.0 - params.seaLevel, 0.001), 0.0, 1.0);
  imageStore(heightMap, pixel, vec4(height));
}
