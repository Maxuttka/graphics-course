#version 430

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8)
uniform writeonly image2D resultImage;

layout(push_constant) uniform Params
{
  float time;
} params;


float sdSphere(vec3 p, float r)
{
  return length(p) - r;
}


float sdPlane(vec3 p)
{
  return p.y;
}


float mapScene(vec3 p)
{
  vec3 spherePos =
    vec3(0.0, 1.0 + 0.7 * sin(params.time), 0.0);

  float sphereDistance =
    sdSphere(p - spherePos, 1.0);

  float planeDistance =
    sdPlane(p);

  return min(sphereDistance, planeDistance);
}


vec3 getNormal(vec3 p)
{
  const float e = 0.001;

  vec3 normal = vec3(
    mapScene(p + vec3(e, 0.0, 0.0)) -
      mapScene(p - vec3(e, 0.0, 0.0)),

    mapScene(p + vec3(0.0, e, 0.0)) -
      mapScene(p - vec3(0.0, e, 0.0)),

    mapScene(p + vec3(0.0, 0.0, e)) -
      mapScene(p - vec3(0.0, 0.0, e))
  );

  return normalize(normal);
}


float rayMarch(vec3 rayOrigin, vec3 rayDirection)
{
  float totalDistance = 0.0;

  for (int i = 0; i < 100; ++i)
  {
    vec3 point =
      rayOrigin + rayDirection * totalDistance;

    float sceneDistance =
      mapScene(point);

    totalDistance += sceneDistance;

    if (
      totalDistance > 100.0 ||
      abs(sceneDistance) < 0.001)
    {
      break;
    }
  }

  return totalDistance;
}


vec3 calculateLighting(vec3 point, vec3 rayDirection)
{
  vec3 normal =
    getNormal(point);

  vec3 lightDirection =
    normalize(vec3(1.0, 1.0, -1.0));

  vec3 viewDirection =
    -rayDirection;

  vec3 ambient =
    vec3(0.1);

  float diffuse =
    max(dot(normal, lightDirection), 0.0);

  vec3 reflection =
    reflect(-lightDirection, normal);

  float specular =
    pow(
      max(dot(viewDirection, reflection), 0.0),
      32.0);

  vec3 baseColor =
    vec3(0.8, 0.3, 0.2);

  return
    ambient * baseColor +
    baseColor * diffuse +
    vec3(1.0) * specular;
}


vec4 shadePixel(vec2 fragmentCoordinate, vec2 resolution)
{
  vec2 uv =
    (fragmentCoordinate - 0.5 * resolution) /
    resolution.y;

  vec3 rayOrigin =
    vec3(0.0, 1.5, 5.0);

  vec3 rayDirection =
    normalize(vec3(uv, -1.0));

  float distance =
    rayMarch(rayOrigin, rayDirection);

  vec3 color;

  if (distance < 100.0)
  {
    vec3 point =
      rayOrigin + rayDirection * distance;

    color =
      calculateLighting(point, rayDirection);
  }
  else
  {
    color =
      vec3(0.5, 0.7, 1.0);
  }

  return vec4(color, 1.0);
}


void main()
{
  ivec2 pixel =
    ivec2(gl_GlobalInvocationID.xy);

  ivec2 resolution =
    imageSize(resultImage);

  if (
    pixel.x >= resolution.x ||
    pixel.y >= resolution.y)
  {
    return;
  }
  vec2 fragCoord =
    vec2(pixel) + vec2(0.5);

  fragCoord.y =
    float(resolution.y) - fragCoord.y;

  vec4 color =
    shadePixel(
      fragCoord,
      vec2(resolution));

  imageStore(resultImage, pixel, color);
}